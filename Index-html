<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rondó — Armado de Boxes</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0e0e0e;
    --surface: #161616;
    --surface2: #1e1e1e;
    --border: rgba(255,255,255,0.08);
    --border2: rgba(255,255,255,0.14);
    --text: #f0ede6;
    --muted: #888;
    --accent: #e8c87a;
    --accent-dim: rgba(232,200,122,0.12);
    --green: #5fcf8a;
    --green-dim: rgba(95,207,138,0.1);
    --red: #f07070;
    --red-dim: rgba(240,112,112,0.1);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; font-weight: 300; min-height: 100vh; padding: 2rem 1rem 4rem; }
  .container { max-width: 680px; margin: 0 auto; }
  header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .brand { font-family: 'DM Serif Display', serif; font-size: 2rem; color: var(--accent); }
  .brand span { color: var(--muted); font-size: .9rem; font-family: 'DM Sans', sans-serif; font-weight: 300; margin-left: .75rem; }
  .section-label { font-size: .68rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: .75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.25rem; }
  .card-accent { border-color: var(--accent); background: linear-gradient(135deg, #1a1810 0%, var(--surface) 60%); }
  .divider { border: none; border-top: 1px solid var(--border); margin: 1.75rem 0; }
  .input-group { display: flex; flex-direction: column; gap: 1.1rem; }
  .input-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .input-label { font-size: .9rem; color: var(--text); flex: 1; }
  .input-sub { font-size: .75rem; color: var(--muted); margin-top: 2px; }
  .qty-control { display: flex; align-items: center; border: 1px solid var(--border2); border-radius: 8px; overflow: hidden; }
  .qty-btn { background: var(--surface2); border: none; color: var(--text); width: 38px; height: 38px; font-size: 1.2rem; cursor: pointer; transition: background .15s; display: flex; align-items: center; justify-content: center; }
  .qty-btn:hover { background: var(--accent); color: var(--bg); }
  .qty-input { background: transparent; border: none; border-left: 1px solid var(--border); border-right: 1px solid var(--border); color: var(--accent); font-size: 1rem; font-weight: 500; font-family: 'DM Sans', sans-serif; width: 52px; height: 38px; text-align: center; outline: none; }
  .qty-input::-webkit-inner-spin-button, .qty-input::-webkit-outer-spin-button { -webkit-appearance: none; }
  .pkg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 1rem; }
  .pkg-card { background: var(--surface2); border-radius: 10px; padding: 1rem 1.1rem; }
  .pkg-icon { font-size: 1.3rem; margin-bottom: .35rem; }
  .pkg-name { font-size: .7rem; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .25rem; }
  .pkg-val { font-size: 1.7rem; font-weight: 500; color: var(--accent); font-family: 'DM Serif Display', serif; line-height: 1; }
  .pkg-detail { font-size: .73rem; color: var(--muted); margin-top: .25rem; line-height: 1.4; }
  .pkg-warn { color: var(--red); font-weight: 500; }
  .resumen { background: var(--accent-dim); border: 1px solid rgba(232,200,122,.2); border-radius: 12px; padding: 1.25rem 1.5rem; }
  .resumen-title { font-size: .7rem; color: var(--accent); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .85rem; }
  .resumen-row { display: flex; justify-content: space-between; align-items: center; padding: .38rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .resumen-row:last-child { border-bottom: none; padding-top: .6rem; margin-top: .25rem; }
  .resumen-key { font-size: .85rem; color: var(--muted); }
  .resumen-val { font-size: .9rem; font-weight: 500; color: var(--text); }
  .resumen-total { font-size: 1.1rem; color: var(--accent); font-family: 'DM Serif Display', serif; }
  .alert-box { margin-top: 1rem; padding: .9rem 1rem; background: var(--red-dim); border: 1px solid rgba(240,112,112,.25); border-radius: 10px; font-size: .8rem; color: var(--red); line-height: 1.6; }
  .empty-state { text-align: center; padding: 2.5rem 1rem; color: var(--muted); font-size: .9rem; border: 1px dashed var(--border2); border-radius: 12px; }
  @media(max-width: 480px) { .pkg-grid { grid-template-columns: 1fr; } .brand { font-size: 1.6rem; } }
</style>
</head>
<body>
<div class="container">

  <header>
    <div class="brand">Rondó <span>armado de boxes</span></div>
  </header>

  <!-- BOXES -->
  <div class="section-label">Boxes a preparar</div>
  <div class="card card-accent">
    <div class="input-group">
      <div class="input-row">
        <div>
          <div class="input-label">Box x4 doble</div>
          <div class="input-sub">8 medallones · 4 panes · 16 cheddars</div>
        </div>
        <div class="qty-control">
          <button class="qty-btn" onclick="change('b4d',-1)">−</button>
          <input class="qty-input" type="number" id="b4d" value="0" min="0" oninput="recalc()">
          <button class="qty-btn" onclick="change('b4d',1)">+</button>
        </div>
      </div>
      <div class="input-row">
        <div>
          <div class="input-label">Box x8 simple</div>
          <div class="input-sub">8 medallones · 8 panes · 16 cheddars</div>
        </div>
        <div class="qty-control">
          <button class="qty-btn" onclick="change('b8s',-1)">−</button>
          <input class="qty-input" type="number" id="b8s" value="0" min="0" oninput="recalc()">
          <button class="qty-btn" onclick="change('b8s',1)">+</button>
        </div>
      </div>
      <div class="input-row">
        <div>
          <div class="input-label">Box x12 doble</div>
          <div class="input-sub">24 medallones · 12 panes · 48 cheddars</div>
        </div>
        <div class="qty-control">
          <button class="qty-btn" onclick="change('b12d',-1)">−</button>
          <input class="qty-input" type="number" id="b12d" value="0" min="0" oninput="recalc()">
          <button class="qty-btn" onclick="change('b12d',1)">+</button>
        </div>
      </div>
    </div>
  </div>

  <hr class="divider">

  <!-- HAMBURGUESAS SUELTAS -->
  <div class="section-label">Hamburguesas sueltas</div>
  <div class="card">
    <div class="input-group">
      <div class="input-row">
        <div>
          <div class="input-label">Dobles sueltas</div>
          <div class="input-sub">2 medallones · 1 pan · 4 cheddars c/u</div>
        </div>
        <div class="qty-control">
          <button class="qty-btn" onclick="change('hd',-1)">−</button>
          <input class="qty-input" type="number" id="hd" value="0" min="0" oninput="recalc()">
          <button class="qty-btn" onclick="change('hd',1)">+</button>
        </div>
      </div>
      <div class="input-row">
        <div>
          <div class="input-label">Simples sueltas</div>
          <div class="input-sub">1 medallón · 1 pan · 2 cheddars c/u</div>
        </div>
        <div class="qty-control">
          <button class="qty-btn" onclick="change('hs',-1)">−</button>
          <input class="qty-input" type="number" id="hs" value="0" min="0" oninput="recalc()">
          <button class="qty-btn" onclick="change('hs',1)">+</button>
        </div>
      </div>
    </div>
  </div>

  <hr class="divider">

  <!-- PANCETA -->
  <div class="section-label">Extra — Panceta (paquetes de 8 fetas)</div>
  <div class="card">
    <div class="input-row">
      <div>
        <div class="input-label">Paquetes de panceta</div>
        <div class="input-sub">8 fetas por paquete</div>
      </div>
      <div class="qty-control">
        <button class="qty-btn" onclick="change('panc',-1)">−</button>
        <input class="qty-input" type="number" id="panc" value="0" min="0" oninput="recalc()">
        <button class="qty-btn" onclick="change('panc',1)">+</button>
      </div>
    </div>
  </div>

  <hr class="divider">

  <!-- PAPAS -->
  <div class="section-label">Extra — Papas rejilla (bolsas de 500g)</div>
  <div class="card">
    <div class="input-row">
      <div>
        <div class="input-label">Bolsas de papas</div>
        <div class="input-sub">500g por bolsa</div>
      </div>
      <div class="qty-control">
        <button class="qty-btn" onclick="change('papa',-1)">−</button>
        <input class="qty-input" type="number" id="papa" value="0" min="0" oninput="recalc()">
        <button class="qty-btn" onclick="change('papa',1)">+</button>
      </div>
    </div>
  </div>

  <hr class="divider">

  <!-- RESULTADO -->
  <div class="section-label">Paquetes a meter en la box</div>
  <div id="resultado">
    <div class="empty-state">Cargá boxes o hamburguesas para ver los paquetes necesarios</div>
  </div>

</div>

<script>
  function change(id, delta) {
    const el = document.getElementById(id);
    el.value = Math.max(0, (parseInt(el.value) || 0) + delta);
    recalc();
  }

  function recalc() {
    const b4d  = parseInt(document.getElementById('b4d').value)  || 0;
    const b8s  = parseInt(document.getElementById('b8s').value)  || 0;
    const b12d = parseInt(document.getElementById('b12d').value) || 0;
    const hd   = parseInt(document.getElementById('hd').value)   || 0;
    const hs   = parseInt(document.getElementById('hs').value)   || 0;
    const panc = parseInt(document.getElementById('panc').value) || 0;
    const papa = parseInt(document.getElementById('papa').value) || 0;

    const totalMed = b4d*8 + b8s*8 + b12d*24 + hd*2 + hs;
    const totalPan = b4d*4 + b8s*8 + b12d*12 + hd   + hs;
    const totalChd = b4d*16 + b8s*16 + b12d*48 + hd*4 + hs*2;
    const totalBurgers = b4d*4 + b8s*8 + b12d*12 + hd + hs;

    const hayAlgo = totalBurgers > 0 || panc > 0 || papa > 0;
    if (!hayAlgo) {
      document.getElementById('resultado').innerHTML =
        '<div class="empty-state">Cargá boxes o hamburguesas para ver los paquetes necesarios</div>';
      return;
    }

    const pkgMed = Math.ceil(totalMed / 4);
    const pkgPan = Math.ceil(totalPan / 4);
    const pkgChd = Math.ceil(totalChd / 8);

    const sobraMed = pkgMed * 4 - totalMed;
    const sobraPan = pkgPan * 4 - totalPan;
    const sobraChd = pkgChd * 8 - totalChd;

    const haySobra = sobraMed > 0 || sobraPan > 0 || sobraChd > 0;

    // Filas del resumen
    let resumenRows = '';
    if (b4d)  resumenRows += `<div class="resumen-row"><span class="resumen-key">Box x4 doble</span><span class="resumen-val">${b4d} box${b4d>1?'es':''}</span></div>`;
    if (b8s)  resumenRows += `<div class="resumen-row"><span class="resumen-key">Box x8 simple</span><span class="resumen-val">${b8s} box${b8s>1?'es':''}</span></div>`;
    if (b12d) resumenRows += `<div class="resumen-row"><span class="resumen-key">Box x12 doble</span><span class="resumen-val">${b12d} box${b12d>1?'es':''}</span></div>`;
    if (hd)   resumenRows += `<div class="resumen-row"><span class="resumen-key">Dobles sueltas</span><span class="resumen-val">${hd} u.</span></div>`;
    if (hs)   resumenRows += `<div class="resumen-row"><span class="resumen-key">Simples sueltas</span><span class="resumen-val">${hs} u.</span></div>`;
    if (panc) resumenRows += `<div class="resumen-row"><span class="resumen-key">Panceta</span><span class="resumen-val">${panc} paq. (${panc*8} fetas)</span></div>`;
    if (papa) resumenRows += `<div class="resumen-row"><span class="resumen-key">Papas rejilla</span><span class="resumen-val">${papa} bolsa${papa>1?'s':''} (${papa*500}g)</span></div>`;

    // Alerta sobrantes
    let alertHtml = '';
    if (haySobra) {
      let items = '';
      if (sobraMed) items += `<br>· <strong>${sobraMed} medallón${sobraMed>1?'es':''}</strong> sobrante${sobraMed>1?'s':''}`;
      if (sobraPan) items += `<br>· <strong>${sobraPan} pan${sobraPan>1?'es':''}</strong> sobrante${sobraPan>1?'s':''}`;
      if (sobraChd) items += `<br>· <strong>${sobraChd} feta${sobraChd>1?'s':''} de cheddar</strong> sobrante${sobraChd>1?'s':''}`;
      alertHtml = `<div class="alert-box">⚠️ Al abrir los paquetes van a sobrar:${items}<br><span style="color:var(--muted);margin-top:.3rem;display:block">Guardá los sobrantes para el próximo pedido.</span></div>`;
    }

    document.getElementById('resultado').innerHTML = `
      <div class="pkg-grid">
        <div class="pkg-card">
          <div class="pkg-icon">🥩</div>
          <div class="pkg-name">Medallones</div>
          <div class="pkg-val">${pkgMed} paq.</div>
          <div class="pkg-detail">${totalMed} unidades necesarias${sobraMed ? `<br><span class="pkg-warn">sobran ${sobraMed}</span>` : ''}</div>
        </div>
        <div class="pkg-card">
          <div class="pkg-icon">🍞</div>
          <div class="pkg-name">Panes brioche</div>
          <div class="pkg-val">${pkgPan} paq.</div>
          <div class="pkg-detail">${totalPan} unidades necesarias${sobraPan ? `<br><span class="pkg-warn">sobran ${sobraPan}</span>` : ''}</div>
        </div>
        <div class="pkg-card">
          <div class="pkg-icon">🧀</div>
          <div class="pkg-name">Cheddars</div>
          <div class="pkg-val">${pkgChd} paq.</div>
          <div class="pkg-detail">${totalChd} fetas necesarias${sobraChd ? `<br><span class="pkg-warn">sobran ${sobraChd}</span>` : ''}</div>
        </div>
        <div class="pkg-card" ${!panc ? 'style="opacity:.35"' : ''}>
          <div class="pkg-icon">🥓</div>
          <div class="pkg-name">Panceta</div>
          <div class="pkg-val">${panc > 0 ? panc + ' paq.' : '—'}</div>
          <div class="pkg-detail">${panc > 0 ? panc*8 + ' fetas en total' : 'No incluida'}</div>
        </div>
        <div class="pkg-card" ${!papa ? 'style="opacity:.35"' : ''}>
          <div class="pkg-icon">🍟</div>
          <div class="pkg-name">Papas rejilla</div>
          <div class="pkg-val">${papa > 0 ? papa + ' bolsa' + (papa>1?'s':'') : '—'}</div>
          <div class="pkg-detail">${papa > 0 ? papa*500 + 'g en total' : 'No incluidas'}</div>
        </div>
      </div>

      <div class="resumen">
        <div class="resumen-title">Resumen del pedido</div>
        ${resumenRows}
        <div class="resumen-row">
          <span class="resumen-key" style="color:var(--text);font-weight:500">Total hamburguesas</span>
          <span class="resumen-total">${totalBurgers}</span>
        </div>
      </div>

      ${alertHtml}
    `;
  }

  recalc();
</script>
</body>
</html>
